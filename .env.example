# Copy this file to .env and replace placeholder values. Never commit .env.

# Optional AI model overrides. Add provider API keys in the website's API Settings instead.
OPENAI_MODEL=
GEMINI_MODEL=
ANTHROPIC_MODEL=

# Optional Adzuna verification source
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=ch,lu,de

# Optional Jooble verification source. Keep the value quoted because it is JSON.
JOOBLE_API_KEYS='{"ch":"your-ch-key","lu":"your-lu-key","de":"your-de-key"}'

# Optional server settings
# HOST=127.0.0.1
# PORT=3000
# CAREER_COPILOT_DATA_DIR=

# Optional canonical URL when Career Copilot is behind Nginx. Set this only after you
# create the first account and migrate legacy browser data at the old URL.
# CAREER_COPILOT_PUBLIC_URL=http://jobs.home.arpa
